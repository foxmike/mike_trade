# OPTIONAL future-use template only. NOT installed by this repository.
#
# mike-trade engine (systemd template for a possible later Ubuntu deployment).
#
# Current DEV execution does NOT use this file: on DEV run the engine via
# `make start` / `python -m mike_trade.cli start`, which reuse the operator's
# normal .env and config files. This template only exists so a future,
# operator-approved deployment script has a sane starting point.
#
# No deployment action has been taken: this file was never copied to
# /etc/systemd/system, never enabled, never started. A separate
# operator-approved script will handle any future deployment.
#
# Substitutions (apply when preparing a future host; edit the copies, not DEV):
#   __OPERATOR_USER__  Existing Linux operator account that owns the checkout
#                      (e.g. mike). Do NOT create a new login or service
#                      account for this template.
#   __REPO_DIR__       Absolute path of the installed checkout
#                      (e.g. /home/mike/mike_trade).
#   __VENV_DIR__       Absolute path of the repo venv (e.g. /home/mike/mike_trade/.venv).
#   __ENV_FILE__       The operator's normal .env for that checkout
#                      (e.g. /home/mike/mike_trade/.env). Reuses the existing
#                      MIKE_TRADE_* conventions (MIKE_TRADE_CONFIG,
#                      MIKE_TRADE_MODE_CONFIG, MIKE_TRADE_DATA_DIR,
#                      MIKE_TRADE_ACCOUNT_MODE, plus the usual Alpaca
#                      credential names from .env.example). Do NOT create
#                      separate /etc/mike-trade/{shadow,paper,live}.env files,
#                      root-owned env layouts, or new secret stores, and do NOT
#                      embed real credentials in this unit.
#   __ACCOUNT__        (optional) account scope passed to the CLI
#                      (e.g. SHADOW:default). Leave empty to use the operator's
#                      normal config/env selection.
#
# User-level alternative: for a per-user deployment instead of a system unit,
# drop the User= line, install the edited copy under
# ~/.config/systemd/user/, and change [Install] to WantedBy=default.target.
#
# Lifecycle notes:
# - Graceful stop is SIGTERM (the default). The engine drains in-process work
#   within a bound and publishes a STOPPED heartbeat. A normal stop leaves
#   open positions in place and never cancels broker-held protective stops;
#   stop/pause/disable-entry controls only affect NEW entries.
# - Restart policy is bounded (Restart=on-failure with burst limits) so a
#   repeatedly crashing engine does not hot-loop forever.
# - No sandbox/permission framework here: ordinary filesystem ownership of the
#   operator account applies. No extra login, credential, or live-confirmation
#   gate is involved in operating this unit.

[Unit]
Description=mike_trade engine (optional future deployment template)
Documentation=https://github.com/mike/mike_trade
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__OPERATOR_USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=-__ENV_FILE__
Environment=PYTHONUNBUFFERED=1
ExecStart=__VENV_DIR__/bin/python -m mike_trade.cli start --account __ACCOUNT__
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
